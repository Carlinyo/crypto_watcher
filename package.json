{
  "name": "crypto-signal-watcher",
  "version": "2.4.0",
  "description": "Круглосуточный анализ топ-криптовалют: уровни, тренд, деривативы, стакан, киты, паттерны, новости, макрокалендарь — уведомления о хорошей цене для покупки или продажи и автоторговля на Bybit",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "once": "node index.js --once",
    "test-notify": "node index.js --test-notify",
    "digest": "node index.js --digest-now",
    "stats": "node index.js --stats",
    "trade-check": "node index.js --trade-check",
    "trade-status": "node index.js --trade-status",
    "pause-trading": "node index.js --pause-trading",
    "resume-trading": "node index.js --resume-trading",
    "backtest": "node backtest.js --grid",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "nodemailer": "10.0.11"
  },
  "license": "MIT"
}
