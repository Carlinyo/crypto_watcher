# Скопируйте в .env и заполните

# ── Что отслеживать ──
SYMBOLS=auto         # auto — топ монет по капитализации и объёму; или свой список: BTCUSDT,ETHUSDT
TOP_N=15             # сколько монет в автоматическом списке
TOP_REFRESH_HOURS=24 # как часто пересматривать список
EXCLUDE=             # какие монеты не брать в топ, через запятую: doge,pepe
INTERVAL=1h          # рабочий таймфрейм: 5m 15m 30m 1h 2h 4h 1d
HTF=4h               # старший таймфрейм для подтверждения тренда
POLL=60              # как часто проверять, секунд
THRESHOLD=0.35       # порог сигнала 0..1 (меньше — чаще, больше — строже)

# ── Почта (Gmail) ──
EMAIL_TO=karenmeliqyan221@gmail.com
SMTP_USER=karenmeliqyan2211@gmail.com   # с какого ящика отправлять
SMTP_PASS=nodg noze khwi tfyw                             # пароль приложения Google (16 символов), НЕ обычный пароль
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ── SMS на телефон (Twilio) ──
SMS_TO=+37498628881
TWILIO_SID=          # Account SID из консоли Twilio
TWILIO_TOKEN=        # Auth Token
TWILIO_FROM=         # номер Twilio, с которого уходят SMS
SMS_ONLY_SIGNALS=1   # 1 — SMS только на ПОКУПКУ/ПРОДАЖУ; 0 — и на «готовиться»

# ── Бесплатный push на телефон (приложение ntfy) ──
NTFY_TOPIC=          # придумайте длинное случайное имя, например crypto-karen-8f3k2q

# ── Telegram (необязательно) ──
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Прочее ──
CRYPTOPANIC_TOKEN=   # необязательно
COINGECKO_KEY=       # необязательно: бесплатный demo-ключ CoinGecko, если упрётесь в лимиты
ERROR_ALERT_AFTER=10 # предупредить, если столько проверок подряд не удались
