# Скопируйте в .env и заполните

# ── Что отслеживать ──
SYMBOLS=auto         # auto — топ монет по капитализации и объёму; или свой список: BTCUSDT,ETHUSDT
TOP_N=15             # сколько монет в автоматическом списке
TOP_REFRESH_HOURS=24 # как часто пересматривать список
EXCLUDE=             # какие монеты не брать в топ, через запятую: doge,pepe
INTERVAL=1h          # рабочий таймфрейм: 5m 15m 30m 1h 2h 4h 1d
HTF=4h               # старший таймфрейм для подтверждения тренда
POLL=60              # как часто проверять, секунд
THRESHOLD=0.35       # порог сигнала 0..1 (меньше — чаще, больше — строже)

# ── Почта (Gmail): все уведомления ──
EMAIL_TO=karenmeliqyan221@gmail.com
SMTP_USER=karenmeliqyan221@gmail.com   # с какого ящика отправлять
SMTP_PASS=                             # пароль приложения Google (16 символов), НЕ обычный пароль
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

NOTIFY_ACTIONS=BUY   # о каких сигналах уведомлять: BUY, SELL, WATCH_BUY, WATCH_SELL

# ── SMS на телефон (Twilio): по умолчанию выключены, все уведомления идут на почту ──
SMS=0                # 1 — включить SMS на сигналы ПОКУПКА
SMS_TO=+37498628881
TWILIO_SID=          # Account SID из консоли Twilio
TWILIO_TOKEN=        # Auth Token
TWILIO_FROM=         # номер Twilio, с которого уходят SMS

# ── 🐋 Киты: крупные рыночные покупки (уведомление на почту) ──
WHALES=1               # 0 — выключить
WHALE_MARKETS=spot,futures
WHALE_MIN_USD=250000   # минимальная сумма сделки кита в $ (для крупных монет порог выше — 0.05% суточного объёма)
WHALE_NOTIFY_MIN_USD=30000000 # уведомлять только о китах от этой суммы (меньше — только журнал и анализ)
WHALE_SELLS=0          # 1 — уведомлять и о крупных продажах
WHALE_SMS=0            # 1 — дублировать китов по SMS (только при SMS=1)
WHALE_COOLDOWN=30      # не чаще раза в N минут по одной монете (кит в 2 раза крупнее приходит сразу)

# ── Прочее ──
CRYPTOPANIC_TOKEN=   # необязательно
COINGECKO_KEY=       # необязательно: бесплатный demo-ключ CoinGecko, если упрётесь в лимиты
ERROR_ALERT_AFTER=10 # предупредить, если столько проверок подряд не удались
