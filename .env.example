# Скопируйте этот файл в .env и заполните. Всё после # — комментарии.

# ── Что отслеживать ──
SYMBOLS=auto            # auto — топ монет по капитализации и объёму; или свой список: BTCUSDT,ETHUSDT
TOP_N=15                # сколько монет в автоматическом списке
TOP_REFRESH_HOURS=24    # как часто пересматривать список
EXCLUDE=                # какие монеты не брать в топ, через запятую: doge,pepe
POLL=60                 # как часто проверять, секунд
TZ=Asia/Yerevan         # часовой пояс для времени в письмах и ежедневного обзора

# ── Сигналы ──
THRESHOLD=0.33          # порог оценки для ПОКУПКИ/ПРОДАЖИ (меньше — чаще, больше — строже); подберите бэктестом
MIN_RR=1.5              # минимальное соотношение прибыль/риск
CONFIRM_POLLS=2         # сколько проверок подряд сигнал должен держаться
MIN_AGREEMENT=0.5       # какая доля блоков анализа должна смотреть в ту же сторону

# ── Размер позиции в письме (необязательно) ──
DEPOSIT=                # депозит в $, например 1000 — тогда в письме будет размер позиции
RISK_PCT=1              # риск на сделку, % от депозита
FEE_PCT=0.2             # комиссия за вход и выход вместе, %

# ── Почта (Gmail): все уведомления ──
EMAIL_TO=karenmeliqyan221@gmail.com
SMTP_USER=karenmeliqyan221@gmail.com   # с какого ящика отправлять
SMTP_PASS=nodg noze khwi tfyw          # пароль приложения Google (16 символов), НЕ обычный пароль
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                        # 587 работает на Hetzner, Oracle и др.; 465 у многих хостингов закрыт

# ── SMS на телефон (Twilio): только сигналы ПОКУПКА / ПРОДАЖА ──
SMS_TO=+37498628881
TWILIO_SID=             # Account SID из консоли Twilio
TWILIO_TOKEN=           # Auth Token
TWILIO_FROM=            # номер Twilio, с которого уходят SMS

# ── Письма ──
BATCH_SECONDS=20        # несрочные уведомления за это время объединяются в одно письмо
MAX_EMAILS_PER_HOUR=30  # потолок писем в час (сигналы ПОКУПКА/ПРОДАЖА проходят всегда)
DIGEST=1                # ежедневный обзор рынка на почту
DIGEST_HOUR=9           # в котором часу (время сервера; в Docker — Ереван)
NEWS_ALERTS=1           # отдельное письмо о важных новостях (взлом, делистинг, иск, ETF)

# ── 🐋 Киты ──
WHALES=1                # 0 — выключить
WHALE_MARKETS=spot,futures
WHALE_MIN_USD=250000    # кит — от этой суммы (для крупных монет порог выше: 0.05% суточного объёма)
WHALE_ALERT_X=2         # письмо — если покупка от 2× порога кита…
WHALE_PER_DAY=3         # …и входит в 3 крупнейших покупки за сутки по этой монете
WHALE_MAX_PER_DAY=30    # не больше писем о китах в сутки
WHALE_COOLDOWN=60       # по одной монете не чаще раза в N минут (кит вдвое крупнее — сразу)
WHALE_SELLS=0           # 1 — присылать и крупные продажи
WHALE_SMS=0             # 1 — дублировать китов по SMS
WHALE_SERIES_TOP_PCT=2  # покупка частями: поток должен входить в 2% самых сильных 10-минутных отрезков за сутки

# ── ⚡ Резкие движения цены ──
MOVE_ALERTS=1           # 0 — не присылать
MOVE_ATR_X5=1.2         # за 5 минут — больше 1.2 часовых ATR…
MOVE_ATR_X15=2          # …или за 15 минут — больше 2 ATR
MOVE_MIN_PCT=1          # но не меньше 1%
MOVE_VOL_X=2.5          # и объём в 2.5 раза выше обычного
MOVE_COOLDOWN=45        # по одной монете не чаще раза в N минут
MOVE_MAX_PER_DAY=20     # не больше таких писем в сутки

# ── 📅 Макрособытия (ФРС, инфляция и занятость в США) ──
MACRO_FILTER=1          # 1 — перед событием и сразу после него новые входы откладываются («готовиться»)
MACRO_ALERTS=1          # письмо-напоминание перед событием
MACRO_ALERT_HOURS=3     # за сколько часов предупреждать

# ── 🤖 Автоторговля на Bybit (USDT-фьючерсы) ──
# Ключ создаётся в Bybit → API: «Read-Write», «Unified Trading → Contract: Orders, Positions».
# Вывод средств НЕ включайте — с таким ключом программа работать откажется.
TRADE=0                 # 1 — открывать сделки по сигналам ПОКУПКА / ПРОДАЖА
TRADE_MODE=demo         # demo — демо-счёт Bybit (виртуальные деньги); live — НАСТОЯЩИЕ деньги
BYBIT_API_KEY=zrq7G4kkTjQgjHT2YQ
BYBIT_API_SECRET=jycvUX6DU7rFMUH5dng6DnqOAIwUZILr21lK
TRADE_RISK_PCT=2        # сколько % баланса теряется, если сработает стоп (размер позиции считается от этого)
TRADE_LEVERAGE=3        # максимальное плечо
TRADE_MAX_POSITIONS=3   # сколько сделок одновременно
TRADE_DAILY_LOSS_PCT=6  # убыток за день (% баланса), после которого новые сделки — только завтра
TRADE_MAX_USD=0         # потолок одной позиции в $ (0 — ограничивает только плечо)
TRADE_MAX_SLIPPAGE=0.5  # не входить, если цена на Bybit ушла от расчётной больше чем на 0.5%
TRADE_MIN_RR=1.2        # не входить, если прибыль/риск от цены Bybit меньше
TRADE_MIN_CONFIDENCE=0  # не входить, если уверенность сигнала ниже (%, 0 — без ограничения)
TRADE_SHORTS=1          # 0 — только лонги (сигналы ПРОДАЖА без сделки)
TRADE_SYMBOLS=          # торговать только этими монетами, напр. BTCUSDT,ETHUSDT (пусто — всеми)
TRADE_SL_TRIGGER=LastPrice  # стоп срабатывает по последней цене (LastPrice) или по маркировочной (MarkPrice)

# ── Источники данных (1 — включено) ──
ORDERBOOK=1             # стакан заявок и стены
DERIVATIVES=1           # открытый интерес, фандинг, позиции трейдеров
COINBASE=1              # премия Coinbase
NEWS=1
GOOGLE_NEWS=1           # новости по каждой монете из Google News
CRYPTOPANIC_TOKEN=      # необязательно
COINGECKO_KEY=          # необязательно: бесплатный demo-ключ CoinGecko, если упрётесь в лимиты

# ── Веб-панель ──
PORT=8080               # 0 — выключить
DASHBOARD_TOKEN=        # если открываете панель наружу — задайте пароль и заходите с ?token=...

ERROR_ALERT_AFTER=10    # предупредить, если столько проверок подряд по монете не удались
